# Copy to `.env` at repo root. Do not commit `.env`.
#
# This project uses hosted OpenAI-compatible APIs only.

# ============================================================
# Hosted OpenAI-compatible mode
# ============================================================
LLM_API_KEY=
# Optional OpenAI-compatible gateway URL:
# LLM_BASE_URL=
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=5

# Hosted model examples:
RAG_CHAT_MODEL=gpt-5.4-mini
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Chroma / persistence
CHROMA_PERSIST_DIRECTORY=./runtime/chroma_db
CHROMA_COLLECTION=tarot_knowledge_base
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tarot_assistant

# ============================================================
# Common RAG settings (used by current code)
# ============================================================
# Retrieval quality
RAG_RAW_TOP_K=10
RAG_MAX_DISTANCE=0.44
RAG_FINAL_TOP_K=6
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHUNKS=6
RAG_MAX_TOKENS=1500
RAG_TEMPERATURE=0.3
RAG_CHROMA_PATH=./runtime/chroma_db
RAG_CORPUS_VERSION=hosted-dev-v1

# Embedding call behavior
OPENAI_EMBED_RETRIES=5
RAG_EMBED_BATCH_SIZE=32

# Indexing/chunking
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=60
RAG_MIN_CHUNK_LEN=60

# Tarot behavior defaults
ENABLE_REVERSED_CARDS=true
DEFAULT_RESPONSE_MODE=detailed

# Optional network proxy
# HTTPS_PROXY=http://127.0.0.1:7890

# Optional CLI preview tuning
# RAG_CLI_CONTEXT_MAX_ITEMS=0
# RAG_CLI_CONTEXT_PREVIEW_CHARS=220
